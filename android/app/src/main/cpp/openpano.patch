 namespace pano {
 
+int g_grid_cols = 0;  // 0 = match all pairs (default).
+
+// Are row-major tiles i and j (in a grid `cols` wide) 8-neighbours?
+static inline bool grid_neighbour(int i, int j, int cols) {
+  int ri = i / cols, ci = i % cols, rj = j / cols, cj = j % cols;
+  return std::abs(ri - rj) <= 1 && std::abs(ci - cj) <= 1;
+}
